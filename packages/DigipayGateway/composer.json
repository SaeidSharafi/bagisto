{
    "name": "kuro/digipay-gateway",
    "description": "Digipay IPG Payment Gateway for Bagisto",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "digipay",
        "payment",
        "gateway",
        "bagisto",
        "ipg"
    ],
    "authors": [
        {
            "name": "Kuro",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "DigipayGateway\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DigipayGateway\\Providers\\DigipayServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
